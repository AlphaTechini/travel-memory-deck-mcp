# Shared by the API and worker
NODE_ENV=development
PORT=8080
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=your-private-deck-bucket
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE=travel-memory-deck-jobs
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=cloud-tasks-worker@your-gcp-project-id.iam.gserviceaccount.com
WORKER_BASE_URL=https://your-private-worker-service.run.app

# API only
MCP_PUBLIC_BASE_URL=https://your-public-api-service.run.app
X402_NETWORK=eip155:1952
X402_PAY_TO_ADDRESS=0x0000000000000000000000000000000000000000
OKX_API_KEY=replace-with-okx-developer-api-key
OKX_SECRET_KEY=replace-with-okx-developer-secret-key
OKX_PASSPHRASE=replace-with-okx-developer-passphrase
